       %{side: :right, byte_offset: 0, byte_length: 1, codepoint_index: 0,
         codepoint_count: 1, codepoints: [?r], skeleton_spans: [%{codepoint_index: 0, codepoint_count: 1}], mapping: "r"},
       %{side: :right, byte_offset: 1, byte_length: 1, codepoint_index: 1,
