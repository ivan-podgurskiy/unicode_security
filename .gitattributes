# Source hashes require byte-for-byte preservation, including upstream line endings.
priv/unicode/18.0.0/* -text
priv/unicode/sources.lock -text
priv/unicode/18.0.0-release.term -text

# Offline regeneration compares these files byte-for-byte on every platform.
lib/unicode_security/data/*.ex text eol=lf

# Tests and CI match LF sequences. Windows checkout must not insert CR.
*.exs text eol=lf
.github/workflows/*.yml text eol=lf
